{
  "name": "mnemosyne-socials",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-test-coverage --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "node --run typecheck && node --run test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26"
  },
  "packageManager": "npm@12.2.3+sha512.a2f98d4517bbe89bdca7513a88e78f43a1fd66be1730eaea81f69e18d86d46f3f75d29762e8fdaf42d4de7f8d194b2ebb2a09e9bfa268067591e96796baca7d5"
}
