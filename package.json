{
  "name": "mnemosyne-socials",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=26" },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-test-coverage --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26"
  }
}
